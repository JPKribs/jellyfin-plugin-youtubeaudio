<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.YouTubeAudio</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227;CA1305</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="YoutubeDLSharp" Version="1.2.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin strings the pages and messages use, built in by Base in every Jellyfin language -->
    <JellyfinString Include="Album" />
    <JellyfinString Include="AlbumArtist" />
    <JellyfinString Include="All" />
    <JellyfinString Include="Artist" />
    <JellyfinString Include="ButtonCancel" />
    <JellyfinString Include="ButtonPause" />
    <JellyfinString Include="ButtonRemove" />
    <JellyfinString Include="ButtonSignIn" />
    <JellyfinString Include="ButtonStop" />
    <JellyfinString Include="ButtonSubmit" />
    <JellyfinString Include="Default" />
    <JellyfinString Include="Delete" />
    <JellyfinString Include="Download" />
    <JellyfinString Include="Genre" />
    <JellyfinString Include="HeaderDeleteItems" />
    <JellyfinString Include="HeaderError" />
    <JellyfinString Include="LabelFailed" />
    <JellyfinString Include="LabelSource" />
    <JellyfinString Include="LabelStatus" />
    <JellyfinString Include="LabelTitle" />
    <JellyfinString Include="LabelYear" />
    <JellyfinString Include="Play" />
    <JellyfinString Include="Preview" />
    <JellyfinString Include="Refresh" />
    <JellyfinString Include="Reset" />
    <JellyfinString Include="Save" />
    <JellyfinString Include="Search" />
    <JellyfinString Include="Select" />
    <JellyfinString Include="SelectAll" />
    <JellyfinString Include="Settings" />
    <JellyfinString Include="Track" />
    <JellyfinString Include="TrackCount" />
  </ItemGroup>

  <ItemGroup>
    <!-- An album cover, not the subtitle aspect mode Jellyfin calls Cover -->
    <JellyfinTextMatch Include="LabelCover" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.YouTubeAudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config pages and public pages -->
    <None Remove="Web\**\*" />
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

</Project>
